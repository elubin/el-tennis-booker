PBP_EMAIL=you@example.com
PBP_PASSWORD=your-password

# CONFIG_PATH defaults to booking.config.json (see docker-compose CONFIG_PATH)

# PlayByCourt queue API (header X-Booking-Secret; same secret as Azure BookingAutomation__Secret)
BOOKING_API_BASE_URL=https://your-api-host
BOOKING_API_SECRET=your-shared-secret

# PlayByPoint booking page (required if config/booking.config.json is missing)
PBP_BOOKING_URL=https://app.playbypoint.com/book/yourclub

# Court/payment for queue booking when booking.config.json is missing (facilityId optional — read from page)
PBP_SURFACE=Hard
PBP_PAYMENT_METHOD=prepaid
# PBP_FACILITY_ID=
# PBP_TIMEZONE=America/New_York

# Second player when a pending row has no user2Id
PBP_DEFAULT_USER2_ID=0

# Web log UI port (http://nas-ip:8888)
# DOZZLE_PORT=8888

# Optional: base64 Playwright storage from `npm run export-session` on your Mac
# PBP_STORAGE_STATE=

# Optional plain-text ping when a slot is found or booked (e.g. ntfy.sh topic URL)
# NOTIFY_WEBHOOK=https://ntfy.sh/your-topic